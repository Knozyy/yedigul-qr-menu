PORT=3001
JWT_SECRET=replace-with-long-random-string
ADMIN_PASSWORD=replace-with-strong-password

# Ters vekil (nginx) arkasında çalıştırıyorsan 1 yap — giriş hız-sınırı
# gerçek istemci IP'sine göre çalışır. Doğrudan internete açıksan BOŞ bırak
# (aksi halde istemci X-Forwarded-For'u sahteleyip limiti aşabilir).
# TRUST_PROXY=1

# Nginx/Cloudflare arkasında çalışırken 127.0.0.1 yap — app portu dışarıya
# kapanır, trafiğin tamamı reverse proxy üzerinden geçer.
# HOST=127.0.0.1
