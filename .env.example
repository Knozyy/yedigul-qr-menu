PORT=3001
JWT_SECRET=replace-with-long-random-string
ADMIN_PASSWORD=replace-with-strong-password

# Lokal geliştirmede varsayılan "full" mod menü + yönetim panelini birlikte açar.
# Üretimde systemd servisleri bunu public/private olarak kendileri ezer;
# .env içinde APP_MODE tanımlamak gerekmez.
# APP_MODE=full

# Ters vekil (nginx) arkasında çalıştırıyorsan 1 yap — giriş hız-sınırı
# gerçek istemci IP'sine göre çalışır. Doğrudan internete açıksan BOŞ bırak
# (aksi halde istemci X-Forwarded-For'u sahteleyip limiti aşabilir).
# TRUST_PROXY=1

# Nginx/Cloudflare arkasında çalışırken 127.0.0.1 yap — app portu dışarıya
# kapanır, trafiğin tamamı reverse proxy üzerinden geçer.
# HOST=127.0.0.1

# ---- Yönetim paneli (/admin/) — ayrıntı: deploy/YONETIM-PANELI.md ----
# Canlıda panelin alan adı. Doluysa yalnız bu Host kabul edilir, çerez
# Secure olur ve istemci IP'si nginx'ten okunur. Lokal geliştirmede BOŞ.
# PUBLIC_HOST=www.yedigulrestorant.com
# İzinli istemci IP'leri, virgülle; CIDR olabilir (88.1.2.0/24).
# PUBLIC_HOST doluyken zorunlu. nginx'teki allow listesiyle aynı tutun.
# ALLOWED_IPS=

PUBLIC_MENU_URL=https://www.yedigulrestorant.com/menu/
# Pano: site sağlığı konektörü bu adresi ve /api/health'i yoklar.
PUBLIC_SITE_URL=https://www.yedigulrestorant.com/
# Pano önbelleği + günlük anlık görüntüler (ayrı SQLite). Boşsa bellekte
# tutulur ve her yeniden başlatmada sıfırlanır.
PANO_DB_PATH=

# Boş bırakılırsa ilgili pano kartı "bağlı değil" görünür.
IG_USER_ID=
IG_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
PLACES_API_KEY=
PLACES_PLACE_ID=

# Ürün formundaki "Çevir" düğmeleri (Türkçeden EN/AR/RU). Anahtar boşsa
# düğmeler görünmez. Model boşsa gemini-flash-lite-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
